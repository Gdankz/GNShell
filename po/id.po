#: prefs.js:60
msgid "Check for shortcut conflicts in GNOME Settings"
msgstr "Periksa bentrokan pintasan di Pengaturan GNOME"

#: prefs.js:61
msgid "Default: &lt;Super&gt;&lt;Shift&gt;n. Do not use a shortcut already taken by another application."
msgstr "Bawaan: &lt;Super&gt;&lt;Shift&gt;n. Jangan pakai pintasan yang sudah dipakai aplikasi lain."

